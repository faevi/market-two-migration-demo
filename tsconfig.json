{
	"compilerOptions": {
		"declaration": true,
		"module": "CommonJS",
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"target": "es2020",
		"noImplicitAny": true,
		"sourceMap": true,
		"outDir": "dist",
		"allowJs": true,
		"baseUrl": ".",
    "paths": {
      "anchor-bankrun": ["libs/anchor-bankrun/dist"],
      "anchor-bankrun/*": ["libs/anchor-bankrun/dist/*"]
    },
		"resolveJsonModule": true,
		"skipLibCheck": true
	},
	"include": ["./**/*"]
}